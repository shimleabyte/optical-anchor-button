{
  "name": "optical-anchor-button",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A precision-inspired React button with an expressive optical signature.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shimleabyte/optical-anchor-button.git"
  },
  "homepage": "https://github.com/shimleabyte/optical-anchor-button",
  "bugs": {
    "url": "https://github.com/shimleabyte/optical-anchor-button/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "button",
    "ui-component",
    "accessibility",
    "optical-anchor"
  ]
}
